{
  "metadata": [
    {
      "src": [
        {
          "files": [ "**/*.csproj" ],
          "src": "../src/OpenVINO.CSharp.API"
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.yml" ],
        "src": "api",
        "dest": "api"
      },
      {
        "files": [ "articles/**/*.md", "*.md", "toc.yml", "restapi/**" ]
      },
      {
        "files": [ "../README.md" ],
        "src": ".."
      }
    ],
    "resource": [
      {
        "files": [ "images/**", "favicon.ico", "logo.svg" ]
      }
    ],
    "overwrite": [
      {
        "files": [ "apidoc/**.md" ],
        "exclude": [ "obj/**", "_site/**" ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "OpenVINO C# API 文档",
      "_appName": "OpenVINO C# API",
      "_appFooter": "<span>Copyright © 2024 Guojin Yan. Licensed under MIT.</span>",
      "_enableSearch": true,
      "_disableNavbar": false,
      "_disableBreadcrumb": false,
      "_disableToc": false,
      "_disableAffix": false,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/guojin-yan/OpenVINO-CSharp-API",
        "branch": "main"
      },
      "_gitUrlPattern": "github"
    },
    "dest": "../_site",
    "template": [ "default", "modern" ],
    "theme": "material",
    "markdownEngineName": "markdig",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "attributes",
        "customcontainers"
      ]
    },
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "sitemap": {
      "baseUrl": "https://guojin-yan.github.io/OpenVINO-CSharp-API",
      "changefreq": "weekly"
    },
    "homepage": "../README.md"
  }
}
